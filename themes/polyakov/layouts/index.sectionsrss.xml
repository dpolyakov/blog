{{ `<?xml version="1.0" encoding="utf-8"?>` | safeHTML }}
{{ $pages := where .Site.RegularPages "Section" "in" (.Site.Params.mainSections | default (slice "blog")) }}
{{ if ge .Site.Config.Services.RSS.Limit 1 }}{{ $pages = first .Site.Config.Services.RSS.Limit $pages }}{{ end }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title><link>{{ .Permalink }}</link><description>{{ .Site.Params.siteDescription | default .Site.Title }}</description>
    <language>{{ .Site.Language.Locale }}</language><generator>Hugo {{ hugo.Version }}</generator>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ "rss.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{ range $pages.ByPublishDate.Reverse }}
      <item>
        <title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid isPermaLink="true">{{ .Permalink }}</guid>
        <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        {{ $content := .Description | default .Summary }}{{ if $.Site.Params.includeContent }}{{ $content = .Content }}{{ end }}
        <description>{{ partial "feed-content.html" (dict "page" . "content" $content) | html }}</description>
        {{ range .GetTerms "categories" }}<category domain="{{ .Permalink }}">{{ .LinkTitle }}</category>{{ end }}
        {{ range .GetTerms "tags" }}<category domain="{{ .Permalink }}">{{ .LinkTitle }}</category>{{ end }}
      </item>
    {{ end }}
  </channel>
</rss>

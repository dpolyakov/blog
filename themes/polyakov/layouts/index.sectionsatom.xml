{{ `<?xml version="1.0" encoding="utf-8"?>` | safeHTML }}
{{ $pages := where .Site.RegularPages "Section" "in" (.Site.Params.mainSections | default (slice "blog")) }}
{{ if ge .Site.Config.Services.RSS.Limit 1 }}{{ $pages = first .Site.Config.Services.RSS.Limit $pages }}{{ end }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ .Site.Language.Lang }}">
  <title>{{ .Site.Title }}</title><subtitle>{{ .Site.Params.siteDescription | default .Site.Title }}</subtitle>
  <id>{{ .Permalink }}</id><updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <link rel="alternate" href="{{ .Permalink }}" /><link rel="self" type="application/atom+xml" href="{{ "atom.xml" | absURL }}" />
  <author><name>{{ .Site.Params.author.name | default .Site.Title }}</name><uri>{{ .Site.BaseURL }}</uri></author>
  {{ range $pages.ByPublishDate.Reverse }}
    <entry>
      <title>{{ .Title }}</title><id>{{ .Permalink }}</id><link rel="alternate" href="{{ .Permalink }}" />
      <published>{{ .PublishDate.Format "2006-01-02T15:04:05Z07:00" }}</published><updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
      <author><name>{{ partial "author.html" . }}</name></author>
      <summary type="html">{{ partial "feed-content.html" (dict "page" . "content" (.Description | default .Summary)) | html }}</summary>
      {{ if $.Site.Params.includeContent }}<content type="html">{{ partial "feed-content.html" (dict "page" . "content" .Content) | html }}</content>{{ end }}
      {{ range .GetTerms "categories" }}<category term="{{ .Title }}" scheme="{{ .Permalink }}" />{{ end }}
      {{ range .GetTerms "tags" }}<category term="{{ .Title }}" scheme="{{ .Permalink }}" />{{ end }}
    </entry>
  {{ end }}
</feed>
